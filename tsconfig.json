
{ 

  "compilerOptions": { 

    "target": "ES2022", 

    "lib": ["ES2022"], 

    "module": "NodeNext", 

    "moduleResolution": "NodeNext", 

    "types": ["node"], 

    "rootDir": "./src", 

    "outDir": "./dist", 

    "strict": true, 

    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true, 

    "skipLibCheck": true, 

    "forceConsistentCasingInFileNames": true, 

    "sourceMap": true 

  }, 

  "include": ["src/**/*.ts"], 

  "exclude": ["node_modules", "dist"] 

}